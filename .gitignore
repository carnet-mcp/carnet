# Runtime artifacts — audit trail, message outbox. Not source.
var/

# Local tooling state, not source
.docker/
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Secrets
.env
.env.*
!.env.example

# Node (frontend)
node_modules/
dist/
# TypeScript's incremental build cache. Machine-local, and it churns on every build.
*.tsbuildinfo

# Windows: Git Bash writes one of these wherever it happened to be when it crashed.
# Not ours, not reproducible, and it reappears — so it is ignored rather than deleted
# each time somebody notices it in `git status`.
*.stackdump
.gstack/

# macOS writes one of these into every directory somebody opens in Finder.
.DS_Store

# `use_the_product.py` mints a real API token and caches it here so a re-run does not
# mint a second. It is a live credential (`art_m_…`) in the working tree of a repository
# that is pushed, which is the one thing that must never be committed by accident.
backend/scripts/.use_the_product_token

# 30 PNGs and a zip of the same, ~19 MB, referenced by nothing in the tree. Kept out of
# history rather than out of the directory: they are regenerated by the browser scripts,
# and a binary that large is permanent once it lands in a commit.
# Screenshots are generated, and the hand-taken ones went stale the moment the product
# was renamed. The directory stays out — except `readme/`, which `scripts/screenshots.py`
# regenerates and the README embeds, so those ship. A re-include has to name the
# directory's contents rather than the directory itself: git will not look inside an
# excluded directory to find an exception.
docs/screenshots/*
!docs/screenshots/readme/
docs/screenshots.zip
