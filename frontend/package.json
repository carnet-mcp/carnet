    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
