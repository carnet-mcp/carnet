# Copy to .env beside compose.yaml, fill in the two values that refuse to default,
# then: docker compose up -d --build
#
# Every value here reaches the containers as environment; nothing else configures the
# deployment. deploy/README.md is the narrative.
#
# If this file arrived inside an offline bundle, the `--build` above is the one line
# that is wrong for you: the images are already loaded and there is nothing to build
# from. `docker compose up -d`, and docs/OFFLINE.md is your narrative instead.

# The name this deployment is reached at — the browser's address bar, and the origin
# OAuth redirect URIs are registered under. `localhost` works for a trial (Caddy signs
# it with its own CA, so the browser warns); a real name gets a real certificate via
# ACME, which needs DNS pointing at this machine and ports 80/443 reachable.
CARNET_DOMAIN=localhost

# Where that name's certificate comes from (step 109). Unset or `acme` is the above.
# `internal` is Caddy's own CA for a name Let's Encrypt cannot reach — an intranet
# name behind a firewall — and the browser warns until that CA is trusted.
# `files` is a certificate your own CA issued: put cert.pem (the chain) and key.pem
# in ./tls, uncomment the volume on the front service in compose.yaml, and the front
# door serves it as-is, refusing at start if either file is missing.
#CARNET_TLS_MODE=acme

# Generate ONCE, and not through compose — while this value is empty, compose refuses
# every subcommand including `build`, so the remedy has to reach around it:
#
#   docker build -t carnet-api --target api -f Dockerfile ..
#   docker run --rm carnet-api carnet --generate-key
#
# Then keep it in your secret store — the same place your database passwords live —
# and set it here (or inject it however your platform injects secrets). The platform
# never keeps a copy, and losing it is losing every delegated credential.
CARNET_SECRET_KEY=

# Who becomes the first administrator, granted at that person's next login while the
# deployment has none. Trust-equivalent to holding this file. Optional — the CLI can
# appoint one instead (carnet --grant-role).
CARNET_BOOTSTRAP_ADMIN=

# --- The identity provider the browser talks to --------------------------------------

# Your provider's issuer URL and the SPA client id registered there (redirect URI:
# https://<CARNET_DOMAIN>/login/callback). The front door derives BOTH halves of
# browser sign-in from this one declaration — /config.json, which the app fetches to
# find its provider, and the Content-Security-Policy naming the origins the browser
# may talk to — so they cannot disagree. The same issuer goes to the API with
# --add-idp (deploy/README.md, day one); these two must name the same provider.
#
# Any OIDC provider works: the app resolves endpoints from the issuer's discovery
# document ({issuer}/.well-known/openid-configuration). Okta, Entra ID, Ping, Auth0,
# Keycloak all serve it at exactly that address. Leave both empty until you have
# one — the stack still comes up, and the sign-in screen says what is missing.
# Changing them later is `docker compose up -d front` (composed at container start).
CARNET_OIDC_ISSUER=
CARNET_OIDC_CLIENT_ID=

# Rarely: scopes other than the default `openid profile email`.
#CARNET_OIDC_SCOPES=openid profile email

# Only for providers whose token endpoint is on a second origin. Google is the known
# one — its issuer is https://accounts.google.com and its token endpoint is on
# https://oauth2.googleapis.com, which the CSP must also name:
#CARNET_OIDC_EXTRA_ORIGINS=https://oauth2.googleapis.com

# --- The database: bundled, or yours -------------------------------------------------

# The bundled Postgres 16. Its port is not published; the password guards only the
# compose-internal network, but change it anyway.
#
# Keep it alphanumeric. It is interpolated into a connection URL, so `@`, `/`, `#` and
# `?` split the URL somewhere unintended and `$` is eaten by compose itself — each of
# which fails as a confusing connection error rather than as a bad password.
COMPOSE_PROFILES=bundled-db
CARNET_DB_PASSWORD=carnet

# Bring your own Postgres (16 or later; RDS, Cloud SQL, Azure all qualify): delete the
# COMPOSE_PROFILES line above and set the DSN instead. Use one dedicated, empty
# database (docs/UPGRADING.md — the migration runner refuses a shared one), and the
# same role for migrating and serving. First `--migrate` in a cluster needs CREATEROLE
# — your managed master user has it — or an administrator runs the two-line remedy the
# refusal prints.
#CARNET_DATABASE_URL=postgresql://user:password@your-host:5432/carnet

# --- Rarely -------------------------------------------------------------------------

# Published ports, for a trial on a machine where 80/443 are taken. A real deployment
# keeps the defaults: ACME's HTTP challenge arrives on 80. If you do shift them, the
# browser's origin no longer matches CARNET_DOMAIN — set the origin explicitly
# below, or every OAuth redirect URI this deployment builds will name the wrong port.
#CARNET_HTTP_PORT=80
#CARNET_HTTPS_PORT=443

# Where a browser reaches this deployment, origin plus the API's prefix. Derived from
# CARNET_DOMAIN unless you set it. This is the value you register at each identity
# provider and connector, so it must be what the browser actually uses.
#CARNET_PUBLIC_ORIGIN=https://carnet.example.com/api

# How long a token minted by an MCP client's OAuth consent lives, in days (step 083).
# Default 30; 0 for no expiry. No refresh token is issued, so an expiry is a re-consent.
#CARNET_OAUTH_TOKEN_DAYS=30

# Retired encryption keys, comma-separated, and ONLY during a key rotation: set the
# new key above, list the old one here, restart, then run `--finish-rotation` until it
# exits 0 and empty this again. See docs/UPGRADING.md.
#CARNET_SECRET_KEYS_OLD=

# The carnet logger's threshold (debug, info, warning, error) and shape (text, or
# json — one object per line for a log pipeline). Both validated: a typo refuses at
# start with a sentence rather than silently meaning info/text. Operational numbers
# live at GET /api/metrics (Prometheus text, admin bearer), beside these.
#CARNET_LOG_LEVEL=info
#CARNET_LOG_FORMAT=json

# How long the append-only log tables keep a record, in days. Unset means forever,
# which is what every deployment does until somebody decides otherwise. Never 0 —
# that is refused rather than read as "off".
#CARNET_RETENTION_DAYS=90

# How often the retention sweep runs, in seconds. Only does anything when a retention
# window is set above; the shipped default is hourly.
#CARNET_RETENTION_SWEEP=3600

# Tool-mode calls one machine token may make through the MCP door (POST /mcp) in a UTC
# day; 0 disables the ceiling. A door call submits no run, so the line above cannot see
# it — this is the bound on the outward door. Counted in the database rather than in the
# server process, so it stays this number however many API replicas you run.
#CARNET_MCP_CALLS_PER_DAY=1000

# The prices the ceilings above are counted against. This is a **path to a JSON file**,
# not a value: unset uses the built-in rate snapshot, and pointing it at your own rates
# means mounting the file into the container too (see the commented volume on the `api`
# service in compose.yaml). Set both, or neither.
#CARNET_MODEL_RATES=/etc/carnet/model-rates.json

# Your OWN networks, which connectors may dial even though they resolve to loopback or
# private addresses — internal MCP/REST services, a sidecar, your model gateway.
# Comma-separated: a hostname, or a network in CIDR (step 109). A name is admitted for
# where it resolves, so an estate on 10.0.0.0/8 is one entry rather than one per
# connector and a restart to add each. Plain http is admitted on the same terms: a
# listed name, or a name whose every answer is inside a claimed network. Empty means
# every connector host must resolve to public addresses (the DNS-rebinding check, step
# 058); link-local — the cloud metadata service — is refused whatever this lists, and
# a claim that covers it (0.0.0.0/0) is refused at start. Every answer a name gives is
# held to the claim, so a name with an AAAA record needs its v6 network claimed too
# (fd00::/8, or ::1/128 for loopback) — the refusal names the answer that was not.
# This is the operator consenting to their own network, which a tenant's host
# allowlist deliberately cannot do.
#CARNET_EGRESS_INTERNAL_HOSTS=10.0.0.0/8,fd00::/8,mcp-sidecar.internal

# Your corporate CA (step 109): the root that re-signs intercepted TLS at your proxy,
# or that issues your internal services' certificates. A file path, so it also means
# mounting the file — see the commented volume on the api service in compose.yaml.
# It REPLACES the bundled public roots rather than adding to them: if any connector
# is dialled direct to the internet, concatenate the public roots into this file.
# (SSL_CERT_FILE is not offered on purpose; a blank one empties the trust store.)
#REQUESTS_CA_BUNDLE=/etc/carnet/ca/corporate-ca.pem

# Your outbound proxy (step 109). Setting this is a declaration: the proxy becomes the
# arbiter of where a dial on the internet lands — a name that resolves public, or does
# not resolve here at all, goes through it BY NAME, and the DNS-rebinding check the
# door normally makes on the resolved address moves to the proxy. Your own networks
# above are dialled direct and keep every check. Three things to know:
#   - HTTPS_PROXY / HTTP_PROXY / NO_PROXY are never read, on purpose; one of them set
#     while this is empty refuses at start. This is the only proxy setting.
#   - http://user:pass@proxy:port works. Kerberos and NTLM proxies do not.
#   - The proxy MUST NOT buffer text/event-stream, or streamed completions through
#     /v1/chat/completions hang and fail on CARNET_MODEL_CHUNK_TIMEOUT — a buffered
#     stream is indistinguishable from a slow model, and there is no fix but the proxy.
#CARNET_EGRESS_PROXY=http://proxy.corp:3128

# Your registry (step 109). The four base images — node, python, caddy, postgres — are
# pinned by digest to Docker Hub, and a policy that says "images come from our mirror" is
# this one prefix. The digests stay: a mirror preserves them, so a retargeted build pulls
# the same bytes from a different address and nothing about reproducibility is spent. A
# path after the host is fine (artifactory.corp/docker-remote); the image names
# (library/python:3.12-slim@sha256:...) follow the prefix unchanged, which is where Docker
# Hub's official images live in every mirror that proxies it. Unset is docker.io and a
# build that is byte-for-byte what it always was.
#CARNET_BASE_REGISTRY=harbor.corp/dockerhub

# Only for a sealed estate, where the images arrived in a tarball (docs/OFFLINE.md).
# Whether the pinned `postgres:16@sha256:...` above resolves against a LOADED image
# depends on which image store your Docker uses, which is not something the far side
# should have to know: `docker save` writes an OCI layout whose index carries the
# digest, the containerd store loads that and keeps it, and the classic store reads the
# legacy manifest.json beside it, which carries tags and no digest — so there the pinned
# reference matches nothing and compose tries to pull it from a registry you do not
# have. This names the loaded tag, which is in the tarball either way. Leave it unset
# anywhere a registry is reachable.
#CARNET_DB_IMAGE=postgres:16

# How long a tool implementation waits for a vendor, in seconds (step 065). Fifteen is
# right for a chat-shaped tool and wrong for a search-shaped one; raise it if you broker a
# slow vendor. A caller sees the timeout as `no reply from the server in time` on a call
# that may well have taken effect, which is why it is worth setting rather than enduring.
#CARNET_REQUEST_TIMEOUT=15

# --- your own vault, if you would rather we did not hold the secret (step 070) --------
#
# A connector's shared credential is normally a variable this deployment holds
# (`--credential-env`). Set these two and it may instead be a location in your own
# 1Password vault (`--credential-ref 'op://Engineering/Jira/credential'`), resolved
# through the service account below on every call and never written to disk or to the
# database.
#
# What this buys, precisely: the secret is not at rest in our database and its lifetime in
# our process is one call. **Not** that we cannot read it — the token below opens every
# item behind every reference, which is true of any vault integration that resolves at
# request time.
#
# What it costs: one to three requests to your vault on every call, with no cache (a
# cached secret is a held secret, and a rotation should take effect on the next call
# rather than the next minute). A reference written with 1Password **ids** costs one
# request; one written with names costs three. Use ids on a hot path.
#
# A connector whose credential is a reference stops working while your vault is down. The
# refusal names the vault and the item rather than reading as a broken credential.
#
# If the vault is on your own network, name its host in CARNET_EGRESS_INTERNAL_HOSTS
# above as well.
#
#CARNET_VAULT_URL=https://vault.acme.internal
#CARNET_VAULT_TOKEN=
# A budget for resolving ONE reference across every hop it takes, not a per-request
# timeout. Default 3 seconds.
#CARNET_VAULT_TIMEOUT_SECONDS=3

# The most bytes an acting-for identity may carry through the door (033c). Raise it only
# for an identity provider whose tokens (group claims and all) exceed 16 KiB.
#CARNET_MCP_MAX_ACTING_FOR_BYTES=16384

# The most bytes one tools/call may carry as arguments through the door. Every
# brokered call records its arguments in the append-only audit log, and a *denied*
# call spends no budget while still writing one — so this, not the ceiling above, is
# what bounds how much an authenticated caller can put in that table.
#CARNET_MCP_MAX_CALL_BYTES=65536

# Live MCP connector sessions across all tenants, before least-recently-used eviction
# starts. Size it from what real traffic says, not from a guess.
#CARNET_MCP_SESSION_POOL_MAX=256
