{
  "id": "azure-openai",
  "name": "Azure OpenAI (AI Foundry) — the OpenAI-compatible surface",
  "description": "Put Carnet in front of a company's Azure OpenAI deployments so its own coding agent changes nothing but its base URL and its key. Step 108. The connector url and host here are placeholders: pass your resource with --url and approve it with --allow-host. Prices are OpenAI's list prices as of 2026-09-09, which Azure matches for the same models; set CARNET_MODEL_RATES or --pricing when yours differ.",
  "verified_on": null,
  "verified_by": "",
  "verified_against": "",
  "hosts": [
    {
      "host": "example-resource.openai.azure.com",
      "why": "A placeholder for your own resource — every Azure OpenAI endpoint is <resource>.openai.azure.com, and which resource is yours to say. Approve yours with `carnet --allow-host <resource>.openai.azure.com` and register with `--url https://<resource>.openai.azure.com`; nothing dials this name. A private-endpoint resource resolves inside your VNet and needs CARNET_EGRESS_INTERNAL_HOSTS as well."
    }
  ],
  "connector": {
    "connector_id": "foundry",
    "kind": "rest",
    "url": "https://example-resource.openai.azure.com",
    "credential_env": "AZURE_OPENAI_KEY",
    "credential_header": "api-key",
    "credential_prefix": "",
    "headers": {},
    "description": "Azure OpenAI, chat completions and embeddings, through the OpenAI-compatible surface"
  },
  "oauth": null,
  "tools": [
    {
      "remote_name": "chat_completions",
      "effect": "write",
      "identity": "service",
      "description": "A chat completion from one of this resource's deployments — what a coding agent asks for on every turn, streamed when it asks.",
      "note": "The surface at /v1/chat/completions and /openai/deployments/{deployment}/chat/completions calls this tool; it recognises it by the binding path. The deployment name is the resource the scope is written against (`azure.deployment`). Every argument the SDK documents is declared so a client's request is accepted as sent; `messages`, `tools`, `functions` and `prediction` are redacted, so the row records who, which deployment, how many tokens and what it cost — never what was said. 4 MiB response cap: a long completion is several hundred kilobytes and the default 64 KiB would cut it off.",
      "redact_args": ["messages", "tools", "functions", "prediction"],
      "max_response_bytes": 4194304,
      "resources": [
        {
          "type": "azure.deployment",
          "args": ["model"],
          "template": null,
          "families": []
        }
      ],
      "binding": {
        "method": "POST",
        "path": "/openai/deployments/{model}/chat/completions",
        "query": ["api-version"],
        "body": [
          "messages", "stream", "stream_options", "temperature", "top_p", "n", "stop",
          "max_tokens", "max_completion_tokens", "presence_penalty", "frequency_penalty",
          "logit_bias", "logprobs", "top_logprobs", "user", "seed", "response_format",
          "tools", "tool_choice", "parallel_tool_calls", "functions", "function_call",
          "reasoning_effort", "verbosity", "metadata", "store", "service_tier",
          "modalities", "prediction", "audio", "data_sources"
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "model": { "type": "string", "description": "The deployment name — the thing in the Azure path and in the Foundry console." },
            "api-version": { "type": "string", "description": "Forwarded exactly as the SDK sent it; Azure refuses a request without one." },
            "messages": { "type": "array" },
            "stream": { "type": "boolean" },
            "stream_options": { "type": "object" },
            "temperature": { "type": ["number", "null"] },
            "top_p": { "type": ["number", "null"] },
            "n": { "type": ["integer", "null"] },
            "stop": {},
            "max_tokens": { "type": ["integer", "null"] },
            "max_completion_tokens": { "type": ["integer", "null"] },
            "presence_penalty": { "type": ["number", "null"] },
            "frequency_penalty": { "type": ["number", "null"] },
            "logit_bias": { "type": ["object", "null"] },
            "logprobs": { "type": ["boolean", "null"] },
            "top_logprobs": { "type": ["integer", "null"] },
            "user": { "type": "string" },
            "seed": { "type": ["integer", "null"] },
            "response_format": { "type": "object" },
            "tools": { "type": "array" },
            "tool_choice": {},
            "parallel_tool_calls": { "type": "boolean" },
            "functions": { "type": "array" },
            "function_call": {},
            "reasoning_effort": { "type": ["string", "null"] },
            "verbosity": { "type": ["string", "null"] },
            "metadata": { "type": "object" },
            "store": { "type": ["boolean", "null"] },
            "service_tier": { "type": ["string", "null"] },
            "modalities": { "type": ["array", "null"] },
            "prediction": { "type": "object" },
            "audio": { "type": ["object", "null"] },
            "data_sources": { "type": "array" }
          },
          "required": ["model", "messages"]
        },
        "usage_map": {
          "model": "model",
          "input_tokens": "usage.prompt_tokens",
          "output_tokens": "usage.completion_tokens",
          "cache_read_tokens": "usage.prompt_tokens_details.cached_tokens"
        },
        "pricing": {
          "gpt-5": { "input": 1.25, "output": 10.0, "cache_read": 0.125, "cache_write": 0.0 },
          "gpt-5-mini": { "input": 0.25, "output": 2.0, "cache_read": 0.025, "cache_write": 0.0 },
          "gpt-5-nano": { "input": 0.05, "output": 0.4, "cache_read": 0.005, "cache_write": 0.0 },
          "gpt-4.1": { "input": 2.0, "output": 8.0, "cache_read": 0.5, "cache_write": 0.0 },
          "gpt-4.1-mini": { "input": 0.4, "output": 1.6, "cache_read": 0.1, "cache_write": 0.0 },
          "gpt-4.1-nano": { "input": 0.1, "output": 0.4, "cache_read": 0.025, "cache_write": 0.0 },
          "gpt-4o": { "input": 2.5, "output": 10.0, "cache_read": 1.25, "cache_write": 0.0 },
          "gpt-4o-mini": { "input": 0.15, "output": 0.6, "cache_read": 0.075, "cache_write": 0.0 },
          "o3": { "input": 2.0, "output": 8.0, "cache_read": 0.5, "cache_write": 0.0 },
          "o4-mini": { "input": 1.1, "output": 4.4, "cache_read": 0.275, "cache_write": 0.0 }
        }
      }
    },
    {
      "remote_name": "embeddings",
      "effect": "write",
      "identity": "service",
      "description": "An embedding from one of this resource's deployments — a coding agent's retrieval.",
      "note": "The surface at /v1/embeddings and /openai/deployments/{deployment}/embeddings calls this tool. `input` is redacted; `usage.prompt_tokens` is the only counter an embedding reports. 16 MiB response cap: a batch of a hundred 3072-dimension vectors is a few megabytes of JSON.",
      "redact_args": ["input"],
      "max_response_bytes": 16777216,
      "resources": [
        {
          "type": "azure.deployment",
          "args": ["model"],
          "template": null,
          "families": []
        }
      ],
      "binding": {
        "method": "POST",
        "path": "/openai/deployments/{model}/embeddings",
        "query": ["api-version"],
        "body": ["input", "encoding_format", "dimensions", "user"],
        "input_schema": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "api-version": { "type": "string" },
            "input": {},
            "encoding_format": { "type": "string" },
            "dimensions": { "type": "integer" },
            "user": { "type": "string" }
          },
          "required": ["model", "input"]
        },
        "usage_map": {
          "model": "model",
          "input_tokens": "usage.prompt_tokens"
        },
        "pricing": {
          "text-embedding-3-small": { "input": 0.02, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0 },
          "text-embedding-3-large": { "input": 0.13, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0 },
          "text-embedding-ada-002": { "input": 0.1, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0 }
        }
      }
    },
    {
      "remote_name": "list_models",
      "effect": "read",
      "identity": "service",
      "description": "The models this resource offers, as Azure lists them.",
      "note": "Not what the surface's /v1/models answers — that is the token's scope, in OpenAI's shape, and calls nothing. This is the resource's own catalogue, for an administrator checking a deployment exists, through the same door.",
      "redact_args": [],
      "resources": [],
      "binding": {
        "method": "GET",
        "path": "/openai/models",
        "query": ["api-version"],
        "body": [],
        "input_schema": {
          "type": "object",
          "properties": {
            "api-version": { "type": "string" }
          },
          "required": []
        }
      }
    }
  ]
}
