# The one place the database lives. `source .env` before the CLI, uvicorn or the scripts.
#
# There is ONE Postgres on a development machine and it is the Docker container below.
# Two servers ran side by side for a whole session once, because a second one was started
# instead of finding the first, and nothing warns you: both answer normally, and the only
# thing deciding which one an app talks to is this string. Hence one file.
#
#   docker start carnet-pg          # if it is not already up

CARNET_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/carnet_demo
CARNET_TENANT=default

# The storage-contract suite's database. Its *contents* are dropped and rebuilt at session
# start, but the database itself must already exist — the suite does not create it, and
# without it every Postgres test errors at setup with "database does not exist":
#
#   docker exec carnet-pg psql -U postgres -c "CREATE DATABASE carnet_test"
#
# Point it at a throwaway, never at the one above.
CARNET_TEST_DSN=postgresql://postgres:postgres@localhost:55432/carnet_test

# The base DSN the scripts/ end-to-end checks splice their own database name into.
CARNET_E2E_PG=postgresql://postgres:postgres@localhost:55432

# Required whenever a database is configured. `carnet --generate-key` prints one.
# **Storing it is your job.** Every delegated credential is encrypted with it and is
# unreadable without it — a regenerated key does not fail loudly, it fails on somebody's
# next call.
CARNET_SECRET_KEY=


# What a model token costs, for pricing what the door's model calls spent. Steps 013 and 045b.
#
# A path to a JSON file, and **unset is the ordinary case**: leave it and the report
# prices against a dated snapshot of list prices in `core/usage.py`, naming it on its own
# second line so nobody mistakes the figure for an invoice. Set it and the report prices
# against your contract instead.
#
# The file is `{"opus": {"input": 15.0, "output": 75.0, "cache_read": 1.5,
# "cache_write": 18.75}, "sonnet": {...}, "haiku": {...}}` — USD per million tokens, all
# four kinds per family. A family with three of them is refused rather than defaulted: a
# missing rate prices that kind of token at nothing and reports a total that looks whole.
#
# Nothing on the call path reads this. The audit row stores tokens and a model name and
# never a dollar figure, because a stored cost is a frozen estimate that reads like an
# invoice and cannot be corrected by fixing the list it came from.
CARNET_MODEL_RATES=
